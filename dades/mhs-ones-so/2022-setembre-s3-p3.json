  "comprovacio": [
    "from math import log10",
    "v, f = 340, 5.40",
    "I0, b1, r1, r2 = 1e-12, 72.0, 5.22e3, 92.3e3",
    "lam = v / f",
    "I1 = I0 * 10**(b1 / 10)",
    "I2 = I1 * r1**2 / r2**2",
    "R = {'lam': lam, 'L': lam / 4, 'I1': I1, 'I2': I2, 'beta2': 10 * log10(I2 / I0)}"
