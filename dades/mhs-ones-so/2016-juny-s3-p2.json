        {
          "titol": "Freqüències",
          "html": "<i>f</i><sub>A</sub> = 1/<i>T</i><sub>A</sub> = 1/1,00 = 1,00 Hz → <i>ω</i><sub>A</sub> = 2π<i>f</i><sub>A</sub> = 2π rad/s. La segona ha de tenir <i>f</i><sub>B</sub> = 2<i>f</i><sub>A</sub> = 2,00 Hz → <i>ω</i><sub>B</sub> = 2π<i>f</i><sub>B</sub> = 4π rad/s."
        },
        {
          "titol": "Constant de les molles",
          "html": "De <i>ω</i><sub>A</sub> = √(<i>k</i>/<i>m</i><sub>A</sub>): <i>k</i> = <i>ω</i><sub>A</sub><sup>2</sup>·<i>m</i><sub>A</sub> = (2π)<sup>2</sup>·0,100 = 0,4π<sup>2</sup> ≈ 3,95 N/m."
        },
        {
          "titol": "Massa de B",
          "html": "Les molles són idèntiques, així que la segona té la mateixa <i>k</i>. De <i>ω</i><sub>B</sub> = √(<i>k</i>/<i>m</i><sub>B</sub>): <i>m</i><sub>B</sub> = <i>k</i>/<i>ω</i><sub>B</sub><sup>2</sup> = 0,4π<sup>2</sup>/(4π)<sup>2</sup> = <span class=\"res\">0,025 kg = 25 g</span>."
        },
        {
          "titol": "Comprovació ràpida",
          "html": "També es pot fer dividint les dues expressions: <i>m</i><sub>B</sub>/<i>m</i><sub>A</sub> = <i>ω</i><sub>A</sub><sup>2</sup>/<i>ω</i><sub>B</sub><sup>2</sup> = (2π)<sup>2</sup>/(4π)<sup>2</sup> = 1/4, i <i>m</i><sub>B</sub> = 0,100/4 = 0,025 kg."
        }
      ],
      "pauta": [
        {
          "punts": 0.2,
          "que": "Calcular les freqüències i les freqüències angulars dels dos objectes (2π i 4π rad/s)."
        },
        {
          "punts": 0.2,
          "que": "Obtenir la constant de la molla a partir de l'objecte A, k = ω_A²·m_A = 0,4π² N/m."
