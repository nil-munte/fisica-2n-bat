  },
  "dades": [
    {
      "simbol": "m_A",
      "valor": "100",
      "unitat": "g",
      "descripcio": "massa de l'objecte A"
    },
    {
      "simbol": "T_A",
      "valor": "1,00",
      "unitat": "s",
      "descripcio": "període de l'objecte A"
    },
    {
      "simbol": "A",
      "valor": "5,00",
      "unitat": "cm",
      "descripcio": "amplitud (la mateixa per als dos objectes)"
    },
    {
      "simbol": "f_B",
      "valor": "2·f_A",
      "unitat": "",
      "descripcio": "la segona molla ha d'oscil·lar amb freqüència doble"
    }
  ],
  "puntuacio": {
    "total": 2,
    "apartats_a_l_enunciat": false,
    "nota": "L'enunciat només diu que cada problema val 2 punts; la pauta dona 1 punt a cada apartat. A l'apartat b, la pauta no puntua a part els instants d'oposició de fase: els explica just després de la gràfica, dins dels 0,6 punts que hi assigna."
  },
  "enunciat": {
    "intro": "<p>Disposem de dues molles iguals. D'una d'elles hi pengem un objecte A de 100 g, que oscil·la amb un període d'1,00 s i una amplitud de 5,00 cm.</p>",
    "figures": [],
    "apartats": [
      {
        "id": "a",
        "punts": 1,
        "text": "Volem que la segona molla oscil·li amb la mateixa amplitud però amb una freqüència que sigui el doble de la de la molla d'on penja A. Quina massa hi hem de penjar?"
      },
      {
        "id": "b",
        "punts": 1,
        "text": "Deixem anar els dos objectes des del punt més baix de la seva oscil·lació. Representeu en una mateixa gràfica velocitat–temps la velocitat de cada objecte durant els primers 2 s, amb les condicions descrites, i indiqueu-hi clarament les magnituds, les unitats i les escales dels eixos. En quins instants d'aquests 2 s la diferència de fase entre els dos objectes és de π rad?"
      }
    ],
    "dades_text": ""
  },
