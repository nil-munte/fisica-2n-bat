  "enunciat": {
    "intro": "<p>L’any 2004 es va aconseguir mesurar la massa d’un virus. Es va determinar la freqüència d’oscil·lació d’un braç horitzontal petitíssim, primer sense el virus i després amb el virus adherit. Sense el virus, la freqüència d’oscil·lació era de 2,00 × 10<sup>15</sup> Hz, i amb el virus, aquesta freqüència va ser de 2,87 × 10<sup>14</sup> Hz.</p>",
    "figures": [],
    "apartats": [
      {
        "id": "a",
        "punts": 1,
        "text": "Si suposem que el braç horitzontal sense el virus adherit es comporta com una molla amb una massa oscil·lant de 2,10 × 10<sup>–16</sup> g lligada a un extrem, quina és la constant elàstica d’aquesta suposada molla?"
      },
      {
        "id": "b",
        "punts": 1,
        "text": "Partint de la mateixa suposició anterior sobre el comportament oscil·latori del sistema, calculeu la massa del virus."
      }
    ],
    "dades_text": ""
  },
  "figures": {},
  "resolucio": [
    {
      "apartat": "a",
      "passos": [
        {
          "titol": "Model de molla",
          "html": "Per a una massa <i>m</i> lligada a una molla de constant <i>k</i>, la freqüència angular és ω = √(<i>k</i>/<i>m</i>)."
        },
        {
          "titol": "Freqüència angular del braç",
          "html": "ω<sub>braç</sub> = 2π<i>f</i><sub>braç</sub> = 2π·2,00·10<sup>15</sup> = 4π·10<sup>15</sup> rad/s ≈ 1,26·10<sup>16</sup> rad/s."
        },
        {
          "titol": "Constant elàstica",
          "html": "Passem la massa a kg: <i>m</i><sub>braç</sub> = 2,10·10<sup>−16</sup> g = 2,10·10<sup>−19</sup> kg. Aïllant <i>k</i>:<br><i>k</i> = <i>m</i><sub>braç</sub>·ω<sub>braç</sub><sup>2</sup> = 2,10·10<sup>−19</sup>·(4π·10<sup>15</sup>)<sup>2</sup> = <span class=\"res\">3,32·10<sup>13</sup> N/m</span>."
        }
      ],
      "pauta": [
        {
          "punts": 0.4,
          "que": "Fer servir la relació ω = √(k/m)."
        },
        {
          "punts": 0.2,
          "que": "Calcular la freqüència angular del braç, ω<sub>braç</sub> = 4π·10¹⁵ rad/s."
        },
        {
          "punts": 0.4,
          "que": "Calcular k = m<sub>braç</sub>·ω<sub>braç</sub>² = 3,32·10¹³ N/m."
        }
      ]
    },
    {
      "apartat": "b",
      "passos": [
        {
          "titol": "Freqüència angular amb el virus",
          "html": "ω<sub>braç+virus</sub> = 2π·2,87·10<sup>14</sup> = 5,74π·10<sup>14</sup> rad/s ≈ 1,80·10<sup>15</sup> rad/s."
        },
        {
          "titol": "Massa oscil·lant",
          "html": "La constant del braç és la mateixa, però ara oscil·len el braç i el virus junts: <i>k</i> = (<i>m</i><sub>braç</sub> + <i>m</i><sub>virus</sub>)·ω<sub>braç+virus</sub><sup>2</sup>."
        },
        {
          "titol": "Massa total",
          "html": "<i>m</i><sub>braç</sub> + <i>m</i><sub>virus</sub> = <i>k</i>/ω<sub>braç+virus</sub><sup>2</sup> = 3,32·10<sup>13</sup>/(5,74π·10<sup>14</sup>)<sup>2</sup> = 1,02·10<sup>−17</sup> kg."
        },
        {
          "titol": "Massa del virus",
          "html": "<i>m</i><sub>virus</sub> = 1,02·10<sup>−17</sup> − 2,10·10<sup>−19</sup> = <span class=\"res\">9,99·10<sup>−18</sup> kg</span>."
        }
      ],
      "pauta": [
        {
          "punts": 0.2,
          "que": "Calcular la freqüència angular amb el virus, ω<sub>braç+virus</sub> = 5,74π·10¹⁴ rad/s."
        },
        {
          "punts": 0.3,
          "que": "Plantejar k = (m<sub>braç</sub> + m<sub>virus</sub>)·ω<sub>braç+virus</sub>² amb la mateixa k."
        },
        {
          "punts": 0.4,
          "que": "Obtenir la massa total oscil·lant, 1,02·10⁻¹⁷ kg."
        },
        {
          "punts": 0.1,
          "que": "Restar la massa del braç: m<sub>virus</sub> = 9,99·10⁻¹⁸ kg."
        }
      ]
    }
