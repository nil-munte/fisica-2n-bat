  "comprovacio": [
    "from math import pi, sin",
    "L = 0.60",
    "f = 200",
    "Ac = 0.02",
    "lam = 2 * L / 3",
    "k = 2 * pi / lam",
    "Amax = Ac / abs(sin(k * L / 2))   # amplitud dels ventres (el centre ja és un ventre)",
    "A20 = Amax * sin(k * 0.20)",
    "R = {'lam': lam, 'v': lam * f, 'vmax': Ac * 2 * pi * f, 'A10': Amax * abs(sin(k * 0.10)), 'A20': round(A20, 12)}"
  ],
