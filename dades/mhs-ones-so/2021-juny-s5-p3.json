</text><circle cx=\"350.0\" cy=\"98\" r=\"3.4\" fill=\"var(--y)\"/><text x=\"350.0\" y=\"168\" text-anchor=\"middle\" font-family=\"var(--f-body)\" font-size=\"12\" font-style=\"italic\" font-weight=\"700\" fill=\"var(--y)\">N</text><circle cx=\"83.3\" cy=\"98\" r=\"2.6\" fill=\"var(--ink)\"/><text x=\"83.3\" y=\"40\" text-anchor=\"middle\" font-family=\"var(--f-body)\" font-size=\"12\" font-style=\"italic\" font-weight=\"700\" fill=\"var(--f)\">V</text><circle cx=\"190.0\" cy=\"98\" r=\"2.6\" fill=\"var(--ink)\"/><text x=\"190.0\" y=\"40\" text-anchor=\"middle\" font-family=\"var(--f-body)\" font-size=\"12\" font-style=\"italic\" font-weight=\"700\" fill=\"var(--f)\">V</text><circle cx=\"296.7\" cy=\"98\" r=\"2.6\" fill=\"var(--ink)\"/><text x=\"296.7\" y=\"40\" text-anchor=\"middle\" font-family=\"var(--f-body)\" font-size=\"12\" font-style=\"italic\" font-weight=\"700\" fill=\"var(--f)\">V</text><line x1=\"30\" y1=\"182\" x2=\"350\" y2=\"182\" stroke=\"var(--muted)\" stroke-width=\"1\"/><path d=\"M30 182 l8 -4 v8 z M350 182 l-8 -4 v8 z\" fill=\"var(--muted)\"/><text x=\"190.0\" y=\"199\" text-anchor=\"middle\" font-family=\"var(--f-body)\" font-size=\"13\" fill=\"var(--ink)\">60 cm</text></svg>",
