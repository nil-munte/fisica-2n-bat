  "resolucio": [
    {
      "apartat": "a",
      "passos": [
        {
          "titol": "Harmònic i longitud d'ona",
          "html": "Un mode amb quatre nodes (dos als extrems) té tres ventres: és el <b>tercer harmònic</b>. Dins la corda hi ha una ona i mitja, <i>L</i> = 1,5·λ, és a dir, λ = 2<i>L</i>/3 = 2·60/3 = 40 cm = <span class=\"res\">0,4 m</span>.",
          "figures": [
            "fig1"
          ]
        },
        {
          "titol": "Velocitat de propagació",
          "html": "<i>v</i> = λ·<i>f</i> = 0,4·200 = <span class=\"res\">80 m/s</span>."
        },
        {
          "titol": "Velocitat vertical màxima al centre",
          "html": "L'ona estacionària és <i>y</i>(<i>x</i>, <i>t</i>) = <i>A</i>·sin <i>kx</i>·cos ω<i>t</i>. Derivant respecte del temps, la velocitat vertical de cada punt és <i>v</i>(<i>x</i>, <i>t</i>) = d<i>y</i>/d<i>t</i> = −<i>A</i>ω·sin <i>kx</i>·sin ω<i>t</i>. Al centre, l'amplitud d'oscil·lació és <i>A</i>·sin <i>kx</i> = 2 cm, de manera que <i>v</i><sub>màx</sub> = <i>A</i>·sin <i>kx</i>·2π<i>f</i> = 0,02·2π·200 = <span class=\"res\">25,1 m/s</span>. (És el mateix que dir que el centre fa un MHS d'amplitud 2 cm: <i>v</i><sub>màx</sub> = <i>A</i>ω.)"
        }
      ],
      "pauta": [
        {
          "punts": 0.5,
          "que": "Reconèixer el tercer harmònic (quatre nodes) i obtenir λ = 2L/3 = 0,4 m."
        },
        {
          "punts": 0.4,
          "que": "Calcular la velocitat de propagació, v = λ·f = 80 m/s."
        },
        {
          "punts": 0.35,
          "que": "Obtenir la velocitat vertical màxima al centre, A·ω = 0,02·2π·200 = 25,1 m/s (derivant l'equació de l'ona estacionària o com a MHS d'amplitud 2 cm)."
        }
      ]
    },
    {
      "apartat": "b",
      "passos": [
        {
          "titol": "Punt a 10 cm d'un extrem",
          "html": "L'extrem és un node i 10 cm és λ/4: com es veu a la figura de l'apartat a, en aquest punt hi ha un ventre. Tots els ventres oscil·len amb la mateixa amplitud que el centre (que també és un ventre), així que l'amplitud és <span class=\"res\">2,00 cm</span>."
        },
        {
          "titol": "Punt a 20 cm d'un extrem",
          "html": "A 20 cm de l'extrem estem a λ/2 d'un node, i dos nodes consecutius estan separats λ/2: aquest punt és un altre node i no oscil·la. L'amplitud hi és <span class=\"res\">0 cm</span>."
        }
      ],
      "pauta": [
        {
          "punts": 0.65,
          "que": "Justificar que a 10 cm hi ha un ventre i que l'amplitud és 2,00 cm."
        },
        {
          "punts": 0.6,
          "que": "Justificar que a 20 cm (λ/2 del node de l'extrem) hi ha un node i l'amplitud és 0."
        }
      ]
    }
