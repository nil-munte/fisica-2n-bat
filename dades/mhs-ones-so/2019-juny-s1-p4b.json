  "resolucio": [
    {
      "apartat": "a",
      "passos": [
        {
          "titol": "Esquema de l'harmònic",
          "html": "Els dos extrems de la corda estan subjectes, de manera que sempre hi ha un node a cada extrem. En el tercer harmònic la corda vibra en tres fusos: hi ha <b>3 ventres</b> i <b>4 nodes</b> (els dos extrems i dos d'interns, a <i>L</i>/3 i 2<i>L</i>/3).",
          "figures": [
            "fig1"
          ]
        },
        {
          "titol": "Longitud d'ona",
          "html": "Al dibuix hi cap una ona i mitja: <i>L</i> = 1,5·λ. De manera general, per a l'harmònic <i>n</i> d'una corda fixa pels dos extrems, λ = 2<i>L</i>/<i>n</i>. Amb <i>n</i> = 3: λ = 2·0,70/3 = <span class=\"res\">0,467 m</span>."
        },
        {
          "titol": "Distància entre nodes consecutius",
          "html": "Entre dos nodes seguits hi ha mitja longitud d'ona (també es veu al dibuix que és un terç de la corda): distància = λ/2 = <i>L</i>/3 = 0,70/3 = <span class=\"res\">0,233 m</span>."
        }
      ],
      "pauta": [
        {
          "punts": 0.4,
          "que": "Dibuixar el tercer harmònic amb els 3 ventres i els 4 nodes (si falten els nodes dels extrems es resten 0,1 p)."
        },
        {
          "punts": 0.3,
          "que": "Obtenir la longitud d'ona, λ = 2L/3 = 0,467 m (o bé de L = 1,5λ)."
        },
        {
          "punts": 0.3,
          "que": "Calcular la distància entre nodes consecutius, λ/2 = L/3 = 0,233 m."
        }
      ]
    },
    {
      "apartat": "b",
      "passos": [
        {
          "titol": "Freqüència",
          "html": "<i>f</i> = <i>v</i>/λ = 308/0,467 = <span class=\"res\">660 Hz</span>."
        },
        {
          "titol": "Període",
          "html": "<i>T</i> = 1/<i>f</i> = 1/660 = <span class=\"res\">1,51·10<sup>−3</sup> s</span>."
        },
        {
          "titol": "Temps entre el punt més alt i el més baix",
          "html": "Un ventre oscil·la verticalment amb el període de l'ona. Passar de l'elongació màxima a la mínima és només mitja oscil·lació: Δ<i>t</i> = <i>T</i>/2 = 1,51·10<sup>−3</sup>/2 = <span class=\"res\">7,58·10<sup>−4</sup> s</span>."
        }
      ],
      "pauta": [
        {
          "punts": 0.4,
          "que": "Calcular la freqüència, f = v/λ = 660 Hz."
        },
        {
          "punts": 0.3,
          "que": "Calcular el període, T = 1/f = 1,51·10⁻³ s."
        },
        {
          "punts": 0.3,
          "que": "Raonar que de dalt a baix el ventre triga mig període: Δt = T/2 = 7,58·10⁻⁴ s."
        }
      ]
    }
  ],
