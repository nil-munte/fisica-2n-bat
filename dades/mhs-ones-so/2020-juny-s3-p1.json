      "passos": [
        {
          "titol": "Energia potencial elàstica",
          "html": "La corba de la gràfica és la paràbola <i>E</i> = ½·<i>k</i>·<i>x</i><sup>2</sup>, de manera que qualsevol punt seu permet trobar <i>k</i>."
        },
        {
          "titol": "Constant elàstica",
          "html": "Per llegir amb més precisió agafem un punt allunyat de l'origen: a <i>x</i> = 15 cm = 0,15 m la gràfica marca <i>E</i> = 2,0 J. Aïllant, <i>k</i> = 2<i>E</i>/<i>x</i><sup>2</sup> = 2·2,0/0,15<sup>2</sup> = <span class=\"res\">178 N/m</span>."
        },
        {
          "titol": "Període",
          "html": "Una oscil·lació completa dura un període: <i>T</i> = <i>t</i>/<i>n</i> = 6,52/10 = <span class=\"res\">0,652 s</span>."
        },
        {
          "titol": "Freqüència angular",
          "html": "ω = 2π/<i>T</i> = 2π/0,652 = 9,64 rad/s."
        },
        {
          "titol": "Massa",
          "html": "En un oscil·lador massa-molla ω = √(<i>k</i>/<i>m</i>), d'on <i>m</i> = <i>k</i>/ω<sup>2</sup> = 178/9,64<sup>2</sup> = <span class=\"res\">1,91 kg</span>."
        }
      ],
      "pauta": [
        {
          "punts": 0.25,
          "que": "Escriure l'energia potencial elàstica, E = ½·k·x²."
        },
