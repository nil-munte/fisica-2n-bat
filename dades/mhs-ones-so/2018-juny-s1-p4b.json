  "enunciat": {
    "intro": "<p>Un gos borda amb una potència de 2,00 mW.</p>",
    "figures": [],
    "apartats": [
      {
        "id": "a",
        "punts": 1,
        "text": "Si aquest so es distribueix uniformement per l’espai, quin és el nivell d’intensitat sonora (en dB) a una distància de 5,00 m?"
      },
      {
        "id": "b",
        "punts": 1,
        "text": "Si en comptes d’un gos, fossin dos gossos bordant alhora, quin seria el nivell d’intensitat sonora?"
      }
    ],
    "dades_text": "Dada: Intensitat del llindar d’audició (0 dB), <i>I</i><sub>0</sub> = 1,00 × 10<sup>–12</sup> W m<sup>–2</sup>."
  },
  "figures": {},
  "resolucio": [
    {
      "apartat": "a",
      "passos": [
        {
          "titol": "Nivell d'intensitat",
          "html": "<i>L</i><sub>1</sub> = 10·log(<i>I</i><sub>1</sub>/<i>I</i><sub>0</sub>); primer cal la intensitat a 5,00 m."
        },
        {
          "titol": "Intensitat",
          "html": "La potència es reparteix uniformement sobre una esfera de radi <i>r</i>: <i>I</i><sub>1</sub> = <i>P</i>/(4π<i>r</i><sup>2</sup>) = 2,00·10<sup>−3</sup>/(4π·5,00<sup>2</sup>) = <span class=\"res\">6,37·10<sup>−6</sup> W/m<sup>2</sup></span>."
        },
        {
          "titol": "Nivell",
          "html": "<i>L</i><sub>1</sub> = 10·log(6,37·10<sup>−6</sup>/1,00·10<sup>−12</sup>) = <span class=\"res\">68,0 dB</span>."
        }
      ],
      "pauta": [
        {
          "punts": 0.2,
          "que": "Escriure la definició del nivell d'intensitat sonora, L = 10·log(I/I₀)."
        },
        {
          "punts": 0.4,
          "que": "Calcular la intensitat a 5,00 m, I = P/(4πr²) = 6,37·10⁻⁶ W/m²."
        },
        {
          "punts": 0.4,
          "que": "Obtenir el nivell, 68,0 dB."
        }
      ]
    },
    {
      "apartat": "b",
      "passos": [
        {
          "titol": "Dos gossos",
          "html": "Les intensitats de les dues fonts se sumen: <i>I</i><sub>2</sub> = 2<i>I</i><sub>1</sub>. Aleshores <i>L</i><sub>2</sub> = 10·log(2<i>I</i><sub>1</sub>/<i>I</i><sub>0</sub>) = 10·log 2 + 10·log(<i>I</i><sub>1</sub>/<i>I</i><sub>0</sub>) = 10·log 2 + <i>L</i><sub>1</sub>."
        },
        {
          "titol": "Resultat",
          "html": "<i>L</i><sub>2</sub> = 3,0 + 68,0 = <span class=\"res\">71,0 dB</span>. També es pot fer amb una potència de 4,00 mW: <i>I</i><sub>2</sub> = 1,27·10<sup>−5</sup> W/m<sup>2</sup>, que dona el mateix nivell."
        }
      ],
      "pauta": [
        {
          "punts": 0.8,
          "que": "Veure que la intensitat es duplica i expressar L₂ = 10·log 2 + L₁ (o calcular-ho amb P = 4 mW)."
        },
        {
          "punts": 0.2,
          "que": "Obtenir L₂ = 71,0 dB."
        }
      ]
    }
  ],
