  "enunciat": {
    "intro": "<p>El terme musical <i>soprano</i> es refereix a la veu més aguda, característica del sexe femení. El rang vocal típic d’aquesta veu és de més de dues octaves, del do<sub>3</sub> (261,7 Hz) al re<sub>5</sub> (1 174,7 Hz).</p>",
    "figures": [],
    "apartats": [
      {
        "id": "a",
        "punts": 1,
        "text": "Calculeu les longituds d’ona dels sons més greu i més agut que pot emetre una cantant <i>soprano</i>."
      },
      {
        "id": "b",
        "punts": 1,
        "text": "En una actuació, un espectador situat a 10,0 m d’una <i>soprano</i> percep un nivell d’intensitat sonora de 80 dB. Calculeu la potència d’aquest so."
      }
    ],
    "dades_text": "Dades: Intensitat del llindar d’audició (0 dB), <i>I</i><sub>0</sub> = 1,0 × 10<sup>–12</sup> W m<sup>–2</sup><br>Velocitat del so en l’aire = 340 m s<sup>–1</sup>"
  },
  "figures": {},
  "resolucio": [
    {
      "apartat": "a",
      "passos": [
        {
          "titol": "Longitud d'ona i freqüència",
          "html": "En l'aire totes les freqüències es propaguen a la mateixa velocitat, de manera que λ = <i>v</i>/<i>f</i>: com més aguda és la nota, més curta és la longitud d'ona."
        },
        {
          "titol": "So més agut i so més greu",
          "html": "λ<sub>agut</sub> = 340/1 174,7 = <span class=\"res\">0,290 m</span><br>λ<sub>greu</sub> = 340/261,7 = <span class=\"res\">1,30 m</span>"
        }
      ],
      "pauta": [
        {
          "punts": 0.2,
          "que": "Escriure la relació λ = v/f."
        },
        {
          "punts": 0.8,
          "que": "Calcular les dues longituds d'ona: 0,290 m (re₅) i 1,30 m (do₃)."
        }
      ]
    },
    {
      "apartat": "b",
      "passos": [
        {
          "titol": "Del nivell a la intensitat",
          "html": "<i>L</i><sub>I</sub> = 10·log(<i>I</i>/<i>I</i><sub>0</sub>) → <i>I</i> = <i>I</i><sub>0</sub>·10<sup><i>L</i><sub>I</sub>/10</sup>."
        },
        {
          "titol": "Intensitat a 10,0 m",
          "html": "<i>I</i> = 10<sup>−12</sup>·10<sup>8</sup> = <span class=\"res\">1,0·10<sup>−4</sup> W/m<sup>2</sup></span>."
        },
        {
          "titol": "Potència i intensitat",
          "html": "La potència es reparteix sobre una esfera centrada en la soprano, de radi igual a la distància a l'espectador: <i>P</i> = <i>I</i>·<i>A</i> = <i>I</i>·4π<i>R</i><sup>2</sup>."
        },
        {
          "titol": "Potència del so",
          "html": "<i>P</i> = 10<sup>−4</sup>·4π·10,0<sup>2</sup> = <span class=\"res\">0,126 W</span>."
        }
      ],
      "pauta": [
        {
          "punts": 0.1,
          "que": "Escriure la definició del nivell d'intensitat i aïllar-ne I."
        },
        {
          "punts": 0.4,
          "que": "Calcular la intensitat, I = 10⁻⁴ W/m²."
        },
        {
          "punts": 0.2,
          "que": "Relacionar potència i intensitat a través de l'àrea d'una esfera, P = I·A."
        },
        {
          "punts": 0.3,
          "que": "Calcular la potència, P = I·4πR² = 0,126 W."
        }
      ]
    }
  ],
