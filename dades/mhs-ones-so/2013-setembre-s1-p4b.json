  "resolucio": [
    {
      "apartat": "a",
      "passos": [
        {
          "titol": "Lectura de l'esquema",
          "html": "A l'extrem obert l'aire vibra amb amplitud màxima (ventre) i a l'extrem tancat no pot vibrar (node). A la figura, del ventre de l'extrem obert al primer node hi ha un quart de longitud d'ona, i després hi ha dos fusos sencers, de mitja longitud d'ona cadascun: <i>L</i> = λ<sub>3</sub>/4 + 2·λ<sub>3</sub>/2 = 5λ<sub>3</sub>/4, és a dir, λ<sub>3</sub> = 4<i>L</i>/5. (És el tercer mode possible del tub: en un tub tancat per un extrem només hi ha els harmònics senars.)",
          "figures": [
            "fig2"
          ]
        },
        {
          "titol": "Relació amb la freqüència",
          "html": "La velocitat del so lliga la longitud d'ona i la freqüència: <i>v</i><sub>so</sub> = λ<sub>3</sub>·ν<sub>3</sub> = (4<i>L</i>/5)·ν<sub>3</sub>."
        },
        {
          "titol": "Llargària del clarinet",
          "html": "Aïllant <i>L</i>: <i>L</i> = 5<i>v</i><sub>so</sub>/(4ν<sub>3</sub>) = 5·340/(4·637) = <span class=\"res\">0,667 m</span> (6,67·10<sup>−1</sup> m)."
        }
      ],
      "pauta": [
        {
          "punts": 0.4,
          "que": "Deduir de l'esquema que L = 5λ₃/4, és a dir, λ₃ = 4L/5."
        },
        {
          "punts": 0.2,
          "que": "Relacionar longitud d’ona i freqüència: v_so = λ₃·ν₃."
        },
        {
          "punts": 0.4,
          "que": "Obtenir la llargària, L = 5v_so/(4ν₃) = 0,667 m."
        }
      ]
    },
    {
      "apartat": "b",
      "passos": [
        {
          "titol": "Nivell inicial",
          "html": "Si a dos metres arriba una intensitat <i>I</i><sub>1</sub>, el nivell de sensació sonora és β<sub>1</sub> = 10·log(<i>I</i><sub>1</sub>/<i>I</i><sub>0</sub>) dB."
        },
        {
          "titol": "Nivell amb la intensitat doble",
          "html": "Ara la intensitat és 2<i>I</i><sub>1</sub>: β<sub>2</sub> = 10·log(2<i>I</i><sub>1</sub>/<i>I</i><sub>0</sub>) = 10·log 2 + 10·log(<i>I</i><sub>1</sub>/<i>I</i><sub>0</sub>) = 10·log 2 + β<sub>1</sub>."
        },
        {
          "titol": "Augment",
          "html": "Δ<i>β</i> = β<sub>2</sub> − β<sub>1</sub> = 10·log 2 = <span class=\"res\">3,01 dB</span>. L'augment no depèn del nivell de partida, i per això no calen ni la intensitat d'1,00·10<sup>−5</sup> W m<sup>−2</sup> ni la distància."
        }
      ],
      "pauta": [
        {
          "punts": 0.4,
          "que": "Escriure el nivell inicial, β₁ = 10·log(I₁/I₀)."
        },
        {
          "punts": 0.4,
          "que": "Escriure el nou nivell amb intensitat 2I₁ i separar-lo com a 10·log 2 + β₁."
        },
        {
          "punts": 0.2,
          "que": "Concloure que el nivell augmenta 3,01 dB."
        }
      ]
