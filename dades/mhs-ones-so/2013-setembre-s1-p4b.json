(--ink)\" stroke-width=\"1\" marker-start=\"url(#ta)\" marker-end=\"url(#tb)\"/><text x=\"346.0\" y=\"163\" font-family=\"var(--f-body)\" font-size=\"13\" fill=\"var(--ink)\"><tspan font-style=\"italic\">λ</tspan><tspan font-size=\"9\" dy=\"3\">3</tspan><tspan dy=\"-3\">/2</tspan></text><line x1=\"42\" y1=\"185\" x2=\"438\" y2=\"185\" stroke=\"var(--ep)\" stroke-width=\"1.2\" marker-start=\"url(#ta)\" marker-end=\"url(#tb)\"/><rect x=\"226.0\" y=\"176\" width=\"28\" height=\"18\" fill=\"var(--surface)\"/><text x=\"240.0\" y=\"190\" text-anchor=\"middle\" font-family=\"var(--f-body)\" font-size=\"14\" font-style=\"italic\" fill=\"var(--ep)\">L</text><line x1=\"40\" y1=\"151\" x2=\"40\" y2=\"189\" stroke=\"var(--muted)\" stroke-width=\"0.8\"/><line x1=\"440\" y1=\"151\" x2=\"440\" y2=\"189\" stroke=\"var(--muted)\" stroke-width=\"0.8\"/><text x=\"44\" y=\"22\" font-family=\"var(--f-body)\" font-size=\"11\" fill=\"var(--muted)\">obert: ventre</text><text x=\"440\" y=\"22\" text-anchor=\"end\" font-family=\"var(--f-body)\" font-size=\"11\" fill=\"var(--muted)\">tancat: node</text></svg>",
