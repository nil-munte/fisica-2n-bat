  "resolucio": [
    {
      "apartat": "a",
      "passos": [
        {
          "titol": "To pur o so complex",
          "html": "És un <b>so complex</b>: l'espectre té molts pics, és a dir, el so és la superposició de components de freqüències diferents. Un to pur tindria un sol pic."
        },
        {
          "titol": "Freqüència fonamental",
          "html": "Els pics estan igualment espaiats i el primer, el pic A, és el fonamental. El pic B és el segon harmònic, amb el doble de freqüència, de manera que <i>f</i><sub>0</sub> = 880/2 = <span class=\"res\">440 Hz</span> (pic A)."
        },
        {
          "titol": "Pic I",
          "html": "Els harmònics tenen freqüències <i>f</i><sub><i>n</i></sub> = <i>n</i>·<i>f</i><sub>0</sub> = <i>n</i>·440 Hz. De A a H hi ha 8 pics, i el pic I seria el novè: <i>f</i><sub>9</sub> = 9·440 = <span class=\"res\">3 960 Hz</span>."
        }
      ],
      "pauta": [
        {
          "punts": 0.3,
          "que": "Dir que és un so complex perquè l'espectre conté moltes freqüències."
        },
        {
          "punts": 0.4,
          "que": "Identificar el pic A com el fonamental i obtenir 880/2 = 440 Hz."
        },
        {
          "punts": 0.3,
          "que": "Calcular la freqüència del pic I, f₉ = 9·440 = 3 960 Hz."
        }
      ]
    },
    {
      "apartat": "b",
