  "resolucio": [
    {
      "apartat": "a",
      "passos": [
        {
          "titol": "Condició del tub obert",
          "html": "Als dos extrems oberts hi ha d'haver ventres. L'ona estacionària més senzilla (el fonamental) té un sol node, al mig del tub, i aleshores la longitud del tub és mitja longitud d'ona: <i>l</i> = λ/2.",
          "figures": [
            "fig1"
          ]
        },
        {
          "titol": "Longitud d'ona fonamental",
          "html": "λ<sub>0</sub> = 2<i>l</i> = 2·1,0 = <span class=\"res\">2,0 m</span>."
        },
        {
          "titol": "Freqüència fonamental",
          "html": "De <i>v</i><sub>0</sub> = λ<sub>0</sub>·<i>f</i><sub>0</sub>: <i>f</i><sub>0</sub> = <i>v</i><sub>0</sub>/λ<sub>0</sub> = 343,0/2,0 = <span class=\"res\">171,5 Hz</span>."
        },
        {
          "titol": "Totes les freqüències",
          "html": "En un tub obert pels dos extrems són possibles tots els harmònics, múltiples enters del fonamental: <span class=\"res\"><i>f</i><sub><i>n</i></sub> = <i>n</i>·<i>f</i><sub>0</sub> = <i>n</i>·171,5 Hz</span>, amb <i>n</i> = 1, 2, 3…"
        },
        {
          "titol": "Totes les longituds d'ona",
          "html": "Les longituds d'ona corresponents són <span class=\"res\">λ<sub><i>n</i></sub> = 2<i>l</i>/<i>n</i> = 2,0/<i>n</i> m</span>, amb <i>n</i> = 1, 2, 3…"
        }
      ],
      "pauta": [
        {
          "punts": 0.2,
          "que": "Relacionar la longitud del tub amb la longitud d'ona del fonamental, l = λ/2."
        },
        {
          "punts": 0.2,
          "que": "Obtenir λ₀ = 2l = 2,0 m."
        },
        {
          "punts": 0.2,
          "que": "Calcular la freqüència fonamental, f₀ = v₀/λ₀ = 171,5 Hz."
        },
        {
          "punts": 0.2,
          "que": "Donar les freqüències permeses, fₙ = n·171,5 Hz."
        },
        {
          "punts": 0.2,
          "que": "Donar les longituds d'ona permeses, λₙ = 2,0/n m."
        }
      ]
    },
    {
      "apartat": "b",
      "passos": [
        {
          "titol": "Què canvia amb l'heli",
          "html": "Les longituds d'ona les fixa la geometria del tub, que no canvia; només canvia la velocitat del so. Per tant, <i>f</i>′<sub><i>n</i></sub> = <i>n</i>·<i>f</i>′<sub>0</sub> = <i>n</i>·<i>v</i><sub>He</sub>/λ<sub>0</sub>."
        },
        {
          "titol": "Freqüències amb heli",
          "html": "<i>f</i>′<sub><i>n</i></sub> = <i>n</i>·975,0/2,0 = <span class=\"res\"><i>n</i>·487,5 Hz</span>, amb <i>n</i> = 1, 2, 3…"
        }
      ],
      "pauta": [
        {
          "punts": 0.5,
          "que": "Escriure les freqüències permeses amb la nova velocitat, f′ₙ = n·v He/λ₀."
        },
        {
          "punts": 0.5,
          "que": "Obtenir f′ₙ = n·487,5 Hz."
        }
      ]
    }
  ],
