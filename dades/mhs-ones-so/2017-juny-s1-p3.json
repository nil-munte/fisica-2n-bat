  "resolucio": [
    {
      "apartat": "a",
      "passos": [
        {
          "titol": "Lectura del gràfic",
          "html": "La corba torna a ser màxima a 1,25 ms, 2,5 ms i 3,75 ms, de manera que el període és <span class=\"res\"><i>T</i> = 1,25 ms</span>. L'elongació oscil·la entre −1,5 cm i +1,5 cm: l'amplitud és <span class=\"res\"><i>A</i> = 1,5 cm</span>."
        },
        {
          "titol": "Freqüència",
          "html": "<i>f</i> = 1/<i>T</i> = 1/(1,25·10<sup>−3</sup>) = <span class=\"res\">800 Hz</span>."
        },
        {
          "titol": "Velocitat de propagació",
          "html": "<i>v</i> = λ·<i>f</i> = 0,200·800 = <span class=\"res\">160 m/s</span>."
        },
        {
          "titol": "Forma de l'equació",
          "html": "L'elongació transversal dels punts de la corda (el gràfic l'anomena x; a l'equació l'escrivim <i>y</i> perquè <i>x</i> és la posició al llarg de la corda) és <i>y</i>(<i>x</i>, <i>t</i>) = <i>A</i>·cos(ω<i>t</i> − <i>k</i><i>x</i> + φ<sub>0</sub>). A <i>x</i> = 0 i <i>t</i> = 0 l'elongació és màxima, +<i>A</i>; amb el cosinus això vol dir φ<sub>0</sub> = 0 (si s'escriu amb sinus, φ<sub>0</sub> = π/2 rad)."
        },
        {
          "titol": "Pulsació i nombre d'ona",
          "html": "ω = 2π<i>f</i> = 2π·800 = <span class=\"res\">1 600π rad/s ≈ 5 027 rad/s</span>; <i>k</i> = 2π/λ = 2π/0,200 = <span class=\"res\">10π rad/m ≈ 31,4 rad/m</span>."
        },
        {
          "titol": "Equació amb valors",
          "html": "<span class=\"res\"><i>y</i>(<i>x</i>, <i>t</i>) = 1,5 cm · cos(1 600π rad/s · <i>t</i> − 10π rad/m · <i>x</i>)</span>, amb <i>t</i> en s i <i>x</i> en m."
        }
      ],
      "pauta": [
        {
          "punts": 0.1,
          "que": "Llegir el període al gràfic, T = 1,25 ms."
        },
        {
          "punts": 0.1,
          "que": "Llegir l'amplitud, A = 1,5 cm."
        },
        {
          "punts": 0.1,
          "que": "Calcular la freqüència, f = 1/T = 800 Hz."
        },
        {
          "punts": 0.1,
          "que": "Calcular la velocitat de propagació, v = λf = 160 m/s."
        },
        {
          "punts": 0.2,
          "que": "Escriure l'equació general de l'ona amb la fase inicial correcta (φ₀ = 0 amb cosinus)."
        },
        {
          "punts": 0.1,
          "que": "Calcular la pulsació, ω = 1 600π rad/s."
        },
        {
          "punts": 0.1,
          "que": "Calcular el nombre d'ona, k = 10π rad/m."
        },
        {
          "punts": 0.2,
          "que": "Escriure l'equació amb els valors i les unitats."
        }
      ]
    },
    {
      "apartat": "b",
      "passos": [
        {
          "titol": "Velocitat d'un punt de la corda",
          "html": "Cada punt de la corda té una posició <i>x</i> fixa; la seva velocitat d'oscil·lació és la derivada de l'elongació respecte del temps: <i>v</i><sub><i>y</i></sub>(<i>x</i>, <i>t</i>) = d<i>y</i>/d<i>t</i> = −<i>A</i>ω·sin(ω<i>t</i> − <i>k</i><i>x</i> + φ<sub>0</sub>)."
        },
        {
          "titol": "Valor màxim",
